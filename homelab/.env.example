# Database Configuration
DB_USER=notary_user
DB_PASSWORD=your_secure_password_here_change_this
DB_PORT=5432

# PgBouncer Configuration
PGBOUNCER_PORT=6432

# Tailscale Configuration (optional but recommended)
TS_AUTHKEY=tskey-auth-your-key-here

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# External Database Access (for Vercel)
# Use Tailscale or set up proper firewall rules
EXTERNAL_DB_HOST=your-tailnet.ts.net
EXTERNAL_DB_PORT=5432