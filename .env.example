# ==========================================
# REQUIRED - Core Platform
# ==========================================

# Database (Auto-set by Railway when you run: railway add --database postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/notary?schema=public"

# NextAuth (Authentication)
NEXTAUTH_URL="http://localhost:3000"  # Change to your Railway URL in production
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Node Environment
NODE_ENV="production"

# ==========================================
# REQUIRED - Payment Processing (Stripe)
# ==========================================
# Cost: 2.9% + $0.30 per transaction (no monthly fee)
# Get keys: https://dashboard.stripe.com/test/apikeys
# Start with TEST keys, switch to LIVE keys when ready

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # Public key (starts with pk_test_ or pk_live_)
STRIPE_SECRET_KEY="sk_test_..."                    # Secret key (starts with sk_test_ or sk_live_)
STRIPE_WEBHOOK_SECRET="whsec_..."                  # Get after creating webhook endpoint

# ==========================================
# REQUIRED - Google Maps API
# ==========================================
# Cost: FREE ($200/month credit, covers ~40,000 requests)
# Get key: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Geocoding API, Distance Matrix API

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ==========================================
# REQUIRED - Business Configuration
# ==========================================

NOTARY_NAME="LA Mobile Notary"
NOTARY_EMAIL="notary@example.com"        # Your business email
NOTARY_PHONE="+1-555-0100"               # Your phone number (format: +1-XXX-XXX-XXXX)
NOTARY_COMMISSION_NUMBER="12345678"      # Your CA notary commission number

# Base Location (Thai Town, LA 90027 by default)
BASE_LOCATION_ZIP="90027"
BASE_LOCATION_LAT="34.0978"
BASE_LOCATION_LNG="-118.2930"

# ==========================================
# RECOMMENDED - Email Notifications
# ==========================================
# Cost: FREE (Resend: 3,000 emails/month free tier)
# Get key: https://resend.com/api-keys
# HIGHLY RECOMMENDED - customers expect confirmation emails

RESEND_API_KEY="re_..."                           # Your Resend API key
RESEND_FROM_EMAIL="LA Mobile Notary <onboarding@resend.dev>"  # Update with your domain later

# Alternative: SendGrid (100 emails/day free)
# SENDGRID_API_KEY="SG..."

# ==========================================
# RECOMMENDED - SMS Notifications
# ==========================================
# Cost: ~$0.0079 per SMS + $1/month phone number
# Free trial: $15 credit (~1,900 free SMS)
# Get keys: https://console.twilio.com
# RECOMMENDED - increases show-up rate by 30%

TWILIO_ACCOUNT_SID="AC..."                        # Your Twilio Account SID
TWILIO_AUTH_TOKEN="..."                           # Your Twilio Auth Token
TWILIO_PHONE_NUMBER="+1234567890"                 # Your Twilio phone number

# ==========================================
# OPTIONAL - Error Tracking (Production)
# ==========================================
# WHEN TO ADD: When you have 50+ bookings/month
# Cost: FREE (Sentry: 5,000 errors/month free tier)
# Get DSN: https://sentry.io
# Uncomment and add DSN when ready:

# SENTRY_DSN="https://...@sentry.io/..."

# ==========================================
# COST SUMMARY
# ==========================================
#
# REQUIRED COSTS:
# - Railway hosting:         $5/month
# - Domain name:             $1/month (~$12/year)
# - Stripe fees:             2.9% + $0.30 per transaction
# - Google Maps:             $0 (free tier)
#                           ─────────────
# SUBTOTAL:                  $6/month
#
# RECOMMENDED COSTS:
# - Email (Resend):          $0 (free tier: 3,000 emails/month)
# - SMS (Twilio):            ~$2/month (60 SMS + phone number)
#                           ─────────────
# TOTAL FIXED:               $8/month
#
# OPTIONAL COSTS (later):
# - Error tracking:          $0 (free tier)
#
# WITH EMAIL & SMS: Keep 96-97% of each booking
# BREAK-EVEN: 1 booking covers entire month!
#
# SEE: COST_OPTIMIZATION.md for detailed breakdown
#
# ==========================================
